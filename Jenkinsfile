pipeline {
	agent any 
	stages {
		stage ('Clone'){
			steps { 
			echo "this is the cloning stage"
				}
				}
		stage ('Build'){
			steps {
			echo "this is the Building stage"
				}			
				}
		stage ('Deploy') {
			steps {
			echo "this is the deploying stage"
				 }
				}
		stage ('status') {
			steps {
			echo "job is finished"
				}
				}
}
}
