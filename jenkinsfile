pipeline {
agent any
        stages  {
                stage ('clone') {
                        steps {
			checkout scm
                        }
                }
		stage ('build') {
			steps {
			sh 'pwd'
			sh 'du -sh'
			sh 'echo "jenkins build number: $Build number" > build.txt
			sh 'ls -lrt'
			archiveArtifacts artifacts: 'build.txt'
				}	
		}
		stage ('deploy') {
			steps {
			echo "cp -r build.war /var/lib/tomcat/webapps"
				}
		}	
		stage ('status'){
			steps {
			echo "this is status"
				}
		}
}
}

