pipeline {
agent any
	options {
	         timestamps()
		}


	environment {
	JOB_type="PIPELINE"
			}	
	parameters {
	choice(
	    name: 'ENVIRONMENT',
		choices: ['dev', 'test', 'prod'],
		description :'select environment'
	      )
		   }

        stages  {
                stage ('clone') {
                        steps {
			checkout scm
                        }
                }
		stage ('branch check') {
                steps { 
              echo "BRANCH_NAME = ${env.BRANCH_NAME}"
		sh 'git branch --show-current'
		sh 'git status'
			}
		}	

		stage ('when Branch Check') { 
       		when { 
			branch 'when'
			}
		steps {
		echo "jenkins is building on the when branch" 
			}
		}

		stage ('build') {
			steps {
			sh 'echo "script: $JOB_type"'
			sh 'echo "Enivironment selected: $ENVIRONMENT"'
			sh 'pwd'
			sh 'du -sh'
			sh 'echo "jenkins build number: $BUILD_NUMBER" > build-$BUILD_NUMBER.txt'
			sh 'ls -lrt'
			archiveArtifacts artifacts: "build-${BUILD_NUMBER}.txt"
				}	
		}
		stage ('test') {
			steps {
			sh 'test -f build-$BUILD_NUMBER.txt'		
			 sh '''
			cat > test-results.xml <<EOF
			<testsuite name="My Tests" tests="1" failures="0">
			    <testcase name="Artifact test"/>
			</testsuite>
			EOF
			'''	
		}
		}
		stage ('deploy dev') {
			when {
			expression {
			     params.ENVIRONMENT == 'dev'
				}
		}	
			steps {
                        echo "Deploying to dev"
				}
		}		
		 stage ('deploy test') {
                        when {
                        expression {
                             params.ENVIRONMENT == 'test'
                                }
                }
                        steps {
                        echo "Deploying to test"
                                }
                }
		stage ('Approval') {
		steps {
		input message: 'Do you want to continue?'
			}
		}

		stage ('after approval') {
		steps {
		sh 'echo "pipeline continue after approval"'
			}
		}

		 stage ('deploy prod') {
                        when {
                        expression {
                             params.ENVIRONMENT == 'prod'
                                }
                }
                        steps {
                        echo "Deploying to prod"
                                }
                }

		stage ('status'){
			steps {
			echo "this is status"
				}
		}
}
		post {
			success{
			echo "pipeline completed successfully"
				}
			failure{
			echo "pipeline failed"
				}
			}
}


