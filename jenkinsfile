pipeline {
agent any
        stages  {
                stage ('clone') {
                        steps {
			checkout scm
                        }
                }
		stage ('build') {
			steps {
			sh 'pwd'
			sh 'du -sh'
			sh 'echo "jenkins build number: $BUILD_NUMBER" > build-$BUILD_NUMBER.txt'
			sh 'ls -lrt'
			archiveArtifacts artifacts: "build-${BUILD_NUMBER}.txt"
				}	
		}
		stage ('test') {
			steps {
			sh 'test -f build-$BUILD_NUMBER.txt'		
			 sh '''
			cat > test-results.xml <<EOF
			<testsuite name="My Tests" tests="1" failures="0">
			    <testcase name="Artifact test"/>
			</testsuite>
			EOF
			'''	
		}
		}
		stage ('deploy') {
			steps {
			echo "cp -r build.war /var/lib/tomcat/webapps"
				}
		}	
		stage ('status'){
			steps {
			echo "this is status"
				}
		}
}
		post {
			success{
			echo "pipeline completed successfully"
				}
			failure{
			echo "pipeline failed"
				}
			}
}


